# Copy to .env.local for local dev, or set these as environment variables
# in your hosting provider (e.g. Vercel project settings) for deployment.
# Get the Supabase values from your Supabase project's Settings -> API page.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. Bypasses Row Level Security entirely; never expose
# this to the browser or commit it. Used only by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Secret — a long random string, used to sign the public staff-access
# session cookie (src/lib/eop-session.ts). Generate one with:
#   openssl rand -base64 32
EOP_SESSION_SECRET=
